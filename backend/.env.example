# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun. .env asla git'e eklenmez.

# OpenAI (ChatGPT) API anahtarı — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Modeller (isteğe göre değiştirilebilir)
OPENAI_STT_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# JWT imzalama anahtarı — uzun ve rastgele bir değer verin
JWT_SECRET=degistir-beni

# Turistin QR ile katıldığı adres. Telefonların erişebileceği adres olmalı
# (ör. http://192.168.1.50:8000 ya da https://hostytalk.app)
PUBLIC_BASE_URL=http://192.168.1.50:8000

# Oturum (QR) geçerlilik süresi, dakika
SESSION_TTL_MINUTES=30

# Deneme paketi aylık konuşma kotası, dakika
TRIAL_MINUTES=60

DATABASE_PATH=hostytalk.db
